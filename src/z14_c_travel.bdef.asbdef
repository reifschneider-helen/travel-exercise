projection;
strict ( 2 );
use draft;

define behavior for Z14_C_Travel alias Travel
use etag
{ use association _Item { create; with draft; }

  use create;
  use update;
  use delete;

  use action cancel_travel;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

define behavior for Z14_C_TravelItem alias Item
use etag
{  use association _Travel { with draft; }

    use update;
    use delete;
}