@Metadata.layer: #CORE
@UI: { 
    headerInfo: { 
    typeName: 'TravelLog',
    typeNamePlural: 'TravelLogs'
    }
}
annotate entity Z14_C_TRAVELLOG
    with 
{
    @UI.facet: [ { 
        id: 'Identification',
        type: #IDENTIFICATION_REFERENCE,
        label: 'TravelLog',
        position: 10
    } ]
    
    @UI.hidden: true
    Uuid;
    
    @UI.lineItem: [ { position: 20 } ]
    @UI.identification: [ { position: 20 } ]
    AgencyId;
    
    @UI.lineItem: [ { position: 30 } ]
    @UI.identification: [ { position: 30 } ]
    TravelId;

    @UI.lineItem: [ { position: 10 } ]
    @UI.identification: [ { position: 10 } ]
    @UI.selectionField: [{ position: 10 }]
    Origin;

    @UI.hidden: true
    LocChangedAt;
    
}